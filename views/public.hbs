<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="canvas">
    <form action="/floor-loads/add/{{ data.load.id }}" class="add-form" method="POST">
      <div>
        <label for="title">Название</label><br>
        <input value="{{ data.load.title }}" class="input" type="text" id="title" name="title" disabled>
      </div>
      <div class="form-field">
        <label for="video">Видео</label><br>
        <video class="media-preview media-video" controls playsinline>
          <source src="/1.mp4" type="video/mp4">
        </video>
      </div>
      <div class="form-field">
        <label for="image">Изображение</label><br>
        <img class="media-preview media-image" src="/1.jpg" alt="Превью изображения">
      </div>
      <div>
        <label for="description">Описание</label><br>
        <textarea class="input" id="description" name="description" rows="10" required>{{ data.load.description }}</textarea>
      </div>
      <div>
        <label for="load">Нормативная нагрузка (кг/м²)</label><br>
        <input value="{{ data.load.standart_load }}" class="input" type="number" id="standard_load" name="standard_load" required>
      </div>
      <div>
        <label for="coefficient">Коэффициент надежности</label><br>
        <input value="{{ data.load.reliability_coefficient }}" class="input short" type="text" id="reliability_coefficient" name="reliability_coefficient" required>
      </div>
      
      
      <div class="form-actions">
        <button class="form-btn" type="submit">ОПУБЛИКОВАТЬ</button>
      </div>
    </form>
    {{> tabbar}}
  </div>
</body>
</html>