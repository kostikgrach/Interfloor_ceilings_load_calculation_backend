<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="canvas">
  <form action="/load-calculation" class="filter-bar" method="POST">
    <label class="filter-bar__label" for="load-min">
      Нормативная нагрузка (кг/м²):
    </label>

    <span class="filter-bar__word">от</span>
    <input type="number" name="minimum" id="load-min" class="filter-bar__input input" value="{{ data.minimum }}" min="0" max="500">

    <span class="filter-bar__word">до</span>
    <input type="number" name="maximum" id="load-max" class="filter-bar__input input" value="{{ data.maximum }}" min="0" max="500">

    <button type="submit" class="filter-bar__btn">НАЙТИ</button>
  </form>
  <div class="card-layout">
    {{#each data.loads }}
      {{> card}}
    {{/each}}
  </div>
  {{> tabbar}}
  </div>
</body>
</html>