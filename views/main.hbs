<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
<body>
  <div class="canvas">
  <label class="filter-bar__label">
    Нормативная нагрузка (кг/м²):
  </label>
  <form action="/floor-loads" class="filter-bar" method="POST">
    {{> range_slider
    name="load"     
    min=0 
    max=500 
    step=10
    valueMin=filter.minimum
    valueMax=filter.maximum
    percentMin=filter.percentMin
    percentMaxInverse=filter.percentMaxInverse}}
    <button type="submit" class="filter-bar__btn">НАЙТИ</button>
  </form>
  <div class="card-layout">
    {{#each data.loads}}
      {{> card}}
    {{/each}}
  </div>
  {{> tabbar}}
  </div>
</body>
</html>