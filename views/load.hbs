<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="canvas">
  <div class="video-wrap">
    <video autoplay muted loop playsinline class="load-video" alt="Ошибка">
      {{#if data.load.video}}
        <source src="http://127.0.0.1:9000/media/{{ data.load.video }}"  type="video/mp4">
      {{else}}
        <source src="/No_video.mp4"  type="video/mp4">
      {{/if}}
    </video>

    <div class="video-overlay">

      <a class="corner-link" href="{{ data.id }}?next=true">
        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24">
        	<path d="M0 0h24v24H0z" fill="none" />
        	<path fill="currentColor" fill-rule="evenodd" d="M2 12c0 5.523 4.477 10 10 10s10-4.477 10-10S17.523 2 12 2S2 6.477 2 12m13.53.47a.75.75 0 0 1 0 1.06l-3 3a.75.75 0 0 1-1.06 0l-3-3a.75.75 0 1 1 1.06-1.06l1.72 1.72V8a.75.75 0 0 1 1.5 0v6.19l1.72-1.72a.75.75 0 0 1 1.06 0" clip-rule="evenodd" />
        </svg>
      </a>

      <div class="video-caption">
        <h1 class="caption-title">{{ data.load.title }}</h1>
        <p class="caption-text">{{ data.load.description }}</p>
      </div>

      <button class="like-btn" data-id="{{ data.id }}" aria-pressed="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24">
        	<path d="M0 0h24v24H0z" fill="none" />
        	<path fill="currentColor" d="M4 21h1V8H4c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2M20 8h-6.61l1.12-3.37c.2-.61.1-1.28-.27-1.8c-.38-.52-.98-.83-1.62-.83h-.61c-.3 0-.58.13-.77.36L7.01 7.44V21h10.31a2 2 0 0 0 1.87-1.3l2.76-7.35c.04-.11.06-.23.06-.35v-2c0-1.1-.9-2-2-2Z" />
        </svg>

        <span class="like-count">{{ data.load.likes.length }}</span>
      </button>

    </div>
  </div>
  {{> tabbar}}
</div>
</body>
</html>
