<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="canvas">
    <form action="" class="add-form" method="POST">
      <div>
        <label for="title">Название</label><br>
        <input class="input" type="text" id="title" name="title" required>
      </div>
      <div>
        <label for="video">Имя видео</label><br>
        <input class="input" type="text" id="video" name="video" required>
      </div>
      <div>
        <label for="image">Имя изображения</label><br>
        <input class="input" type="text" id="image" name="image" required>
      </div>
      <div class="form-actions">
        <button class="form-btn" type="submit">ДАЛЕЕ</button>
      </div>
    </form>
    {{> tabbar}}
  </div>
</body>
</html>